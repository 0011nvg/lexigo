{
  "name": "LEXIGO PR8 static preview",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "LEXIGO static preview",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postStartCommand": "python3 -m http.server 4173 --bind 0.0.0.0",
  "customizations": {
    "codespaces": {
      "openFiles": ["index.html"]
    }
  }
}
